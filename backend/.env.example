EMAIL_HOST_PASSWORD=your_16_char_app_password

# SendGrid fallback
SENDGRID_API_KEY=

FCM_SERVER_KEY=
GOOGLE_MAPS_API_KEY=

# Auto-created admin on every deploy (only if not already exists)
